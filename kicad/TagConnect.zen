load("../properties.zen", "Properties")

# -----------------------------------------------------------------------------
# Component types
# -----------------------------------------------------------------------------

TagConnectType = enum(
    "TC2030-IDC-NL-2x03",
    "TC2030-IDC-FP-2x03",
    "TC2030-IDC-NL-2x03-SWD",
    "TC2030-IDC-FP-2x03-SWD",
    "TC2050-IDC-NL-2x05",
    "TC2050-IDC-FP-2x05",
    "TC2050-IDC-NL-2x05-BottomClip",
    "TC2070-IDC-FP-2x07",
)

# -----------------------------------------------------------------------------
# Component parameters
# -----------------------------------------------------------------------------

tag_type = config("tag_type", TagConnectType, convert = TagConnectType)
properties = config("properties", dict, optional = True)

# -----------------------------------------------------------------------------
# Helper functions
# -----------------------------------------------------------------------------

# Pin count mapping
PIN_COUNT_MAP = {
    "TC2030-IDC-NL-2x03": 6,
    "TC2030-IDC-FP-2x03": 6,
    "TC2030-IDC-NL-2x03-SWD": 6,
    "TC2030-IDC-FP-2x03-SWD": 6,
    "TC2050-IDC-NL-2x05": 10,
    "TC2050-IDC-FP-2x05": 10,
    "TC2050-IDC-NL-2x05-BottomClip": 10,
    "TC2070-IDC-FP-2x07": 14,
}

def PinCount(tag_type: TagConnectType) -> int:
    return PIN_COUNT_MAP[tag_type.value]

# Footprint mapping
FOOTPRINT_MAP = {
    "TC2030-IDC-NL-2x03": "@kicad-footprints/Connector.pretty/Tag-Connect_TC2030-IDC-NL_2x03_P1.27mm_Vertical.kicad_mod",
    "TC2030-IDC-FP-2x03": "@kicad-footprints/Connector.pretty/Tag-Connect_TC2030-IDC-FP_2x03_P1.27mm_Vertical.kicad_mod",
    "TC2030-IDC-NL-2x03-SWD": "@kicad-footprints/Connector.pretty/Tag-Connect_TC2030-IDC-NL_2x03_P1.27mm_Vertical.kicad_mod",
    "TC2030-IDC-FP-2x03-SWD": "@kicad-footprints/Connector.pretty/Tag-Connect_TC2030-IDC-FP_2x03_P1.27mm_Vertical.kicad_mod",
    "TC2050-IDC-NL-2x05": "@kicad-footprints/Connector.pretty/Tag-Connect_TC2050-IDC-NL_2x05_P1.27mm_Vertical.kicad_mod",
    "TC2050-IDC-FP-2x05": "@kicad-footprints/Connector.pretty/Tag-Connect_TC2050-IDC-FP_2x05_P1.27mm_Vertical.kicad_mod",
    "TC2050-IDC-NL-2x05-BottomClip": "@kicad-footprints/Connector.pretty/Tag-Connect_TC2050-IDC-NL_2x05_P1.27mm_Vertical_with_bottom_clip.kicad_mod",
    "TC2070-IDC-FP-2x07": "@kicad-footprints/Connector.pretty/Tag-Connect_TC2070-IDC-FP_2x07_P1.27mm_Vertical.kicad_mod",
}

def _footprint(tag_type: TagConnectType):
    """Get the KiCad footprint name for a Tag-Connect type."""
    return FOOTPRINT_MAP[tag_type.value]

# Symbol mapping - SWD vs generic symbols for TC2030
SYMBOL_MAP = {
    "TC2030-IDC-NL-2x03": {
        "library": "@kicad-symbols/Connector.kicad_sym",
        "name": "TC2030",
    },
    "TC2030-IDC-FP-2x03": {
        "library": "@kicad-symbols/Connector.kicad_sym", 
        "name": "TC2030",
    },
    "TC2030-IDC-NL-2x03-SWD": {
        "library": "@kicad-symbols/Connector.kicad_sym",
        "name": "Conn_ARM_SWD_TagConnect_TC2030-NL",
    },
    "TC2030-IDC-FP-2x03-SWD": {
        "library": "@kicad-symbols/Connector.kicad_sym", 
        "name": "Conn_ARM_SWD_TagConnect_TC2030",
    },
    "TC2050-IDC-NL-2x05": {
        "library": "@kicad-symbols/Connector.kicad_sym",
        "name": "TC2050",
    },
    "TC2050-IDC-FP-2x05": {
        "library": "@kicad-symbols/Connector.kicad_sym",
        "name": "TC2050",
    },
    "TC2050-IDC-NL-2x05-BottomClip": {
        "library": "@kicad-symbols/Connector.kicad_sym",
        "name": "TC2050",
    },
    "TC2070-IDC-FP-2x07": {
        "library": "@kicad-symbols/Connector.kicad_sym",
        "name": "TC2070",
    },
}

def _symbol(tag_type: TagConnectType):
    """Get the appropriate symbol for a Tag-Connect type."""
    return SYMBOL_MAP[tag_type.value]

# Pin name mappings for SWD connector types
SWD_PIN_NAMES = {
    "TC2030-IDC-NL-2x03-SWD": ["VCC", "SWDIO", "~{RESET}", "SWCLK", "GND", "SWO"],
    "TC2030-IDC-FP-2x03-SWD": ["VCC", "SWDIO", "~{RESET}", "SWCLK", "GND", "SWO"],
}

def _get_pins(tag_type: TagConnectType):
    """Generate pin mapping based on connector type."""
    pins = {}
    
    if tag_type.value in SWD_PIN_NAMES:
        # Use SWD-specific pin names
        pin_names = SWD_PIN_NAMES[tag_type.value]
        for i, pin_name in enumerate(pin_names, 1):
            pins[pin_name] = io("P{}".format(i), Net)
    else:
        # Use numbered pin names for non-SWD connectors
        pin_count = PinCount(tag_type)
        for i in range(1, pin_count + 1):
            pins[str(i)] = io("P{}".format(i), Net)
    
    return pins

# -----------------------------------------------------------------------------
# IO ports
# -----------------------------------------------------------------------------

pins = _get_pins(tag_type)

# -----------------------------------------------------------------------------
# Component definition
# -----------------------------------------------------------------------------

Component(
    name = "TAG_CONNECT",
    symbol = Symbol(**_symbol(tag_type)),
    footprint = File(_footprint(tag_type)),
    prefix = "J",
    pins = pins,
    properties = Properties(
        properties,
        {
            "tag_type": tag_type,
            "exclude_from_bom": True,
            "do_not_populate": True,
        },
    ),
)
