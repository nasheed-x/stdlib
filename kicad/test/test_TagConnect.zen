load("../../properties.zen", "Layout")

TagConnect = Module("../TagConnect.zen")

# Test all TagConnect variants
for tag_type in TagConnect.TagConnectType:
    name = "TagConnect_" + tag_type.value.replace("-", "_")
    pin_count = TagConnect.PinCount(tag_type)
    pins = {"P{}".format(i): Net("P{}".format(i)) for i in range(1, pin_count + 1)}
    TagConnect(name = name, tag_type = tag_type.value, **pins)

Layout(
    name = "preview",
    path = "build/TagConnect",
)
